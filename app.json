{
  "expo": {
    "name": "PiDevKit IDE",
    "slug": "pidevkit",
    "version": "1.0.0",
    "scheme": "pidevkit",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#040404"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pidevkit.ide"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#040404"
      },
      "package": "com.pidevkit.ide"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cb91563e-7849-4360-9653-faf7fb10f3d6"
      }
    }
  }
}
